# copied and modified from https://github.com/NVIDIA/warp/blob/main/.gitattributes
* text=auto
*.sh text eol=LF
# manifest.json 记录 deploy.yaml 的 sha256，必须与检出的字节一致，因此固定为 LF；
# 同目录的 onnx/bin 是二进制，显式声明避免被文本化。
deploy/robots/g1_29dof/config/policy/holo_wbt/**/deploy.yaml text eol=LF
deploy/robots/g1_29dof/config/policy/holo_wbt/**/manifest.json text eol=LF
deploy/robots/g1_29dof/config/policy/holo_wbt/**/*.onnx binary
deploy/robots/g1_29dof/config/policy/holo_wbt/**/*.bin binary
# BeyondMimic packages: the manifest records the sha256 of the checked-out bytes, and the
# robot is Linux. Pin the text files to LF so a Windows checkout cannot break the check.
deploy/robots/g1_29dof/config/policy/beyondmimic/**/deploy.yaml text eol=LF
deploy/robots/g1_29dof/config/policy/beyondmimic/**/manifest.json text eol=LF
deploy/robots/g1_29dof/config/policy/beyondmimic/**/*.onnx binary
deploy/robots/g1_29dof/config/policy/beyondmimic/**/*.bin binary
